# ==============================================================================
# DREAMLOOM FINANCIAL BMS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your Vercel Project Settings -> Environment Variables for production.
# NEVER commit real passwords, connection strings, or API keys to GitHub.

# Primary PostgreSQL Connection String (Pooled or Direct)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL="postgresql://db_user:db_password@db_host:5432/dreamloom_bms?schema=public"

# Optional Direct PostgreSQL Connection String (Used for Prisma migrations when using PgBouncer/Neon/Supabase poolers)
DIRECT_URL="postgresql://db_user:db_password@db_host:5432/dreamloom_bms?schema=public"

# Application Runtime Environment ("development" | "production")
NODE_ENV="production"

# Public Application Base URL (Optional, used for metadata/links)
NEXT_PUBLIC_APP_URL="https://dreamloom-bms.vercel.app"
