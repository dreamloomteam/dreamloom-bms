datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  passwordHash   String
  fullName       String
  role           String     @default("Member")
  isActive       Boolean    @default(true)
  mustChangePass Boolean    @default(true)
  loginLogs      LoginLog[]
  editLogs       EditLog[]
  member         Member?
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  email      String?
  fullName   String?
  action     String?  @default("LOGIN")
  sessionRef String?
  success    Boolean
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model EditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  model     String   // e.g., "Contribution"
  action    String   // "create", "update", "delete"
  recordId  Int?
  changes   String?
  createdAt DateTime @default(now())
}

model Member {
  id                   Int                   @id @default(autoincrement())
  fullName             String
  nationalId           String                @unique
  phone                String
  email                String                @unique
  role                 String                @default("Member")
  contributions        Contribution[]
  contributionPayments ContributionPayment[]
  loans                Loan[]
  loanRepayments       LoanRepayment[]
  penalties            Penalty[]
  deposits             Deposit[]
  userId               Int?                  @unique
  user                 User?                 @relation(fields: [userId], references: [id])
  emergencyAllocations  EmergencyFundAllocation[]
  emergencyApplications EmergencyLoanApplication[]
  emergencyLoans        EmergencyLoan[]
  emergencyRepayments   EmergencyLoanRepayment[]
}

model Contribution {
  id               Int                   @id @default(autoincrement())
  memberId         Int?
  member           Member?               @relation(fields: [memberId], references: [id])
  monthYear        String
  month            String?
  year             Int?
  expectedAmount   Float                 @default(6000.0)
  amount           Float                 @default(0.0)
  unsettled        Float                 @default(0.0)
  creditBalance    Float                 @default(0.0)
  payout           Float                 @default(0.0)
  paymentDate      String?
  paymentMethod    String?               @default("M-Pesa")
  mpesaRef         String?
  bankRef          String?
  paymentReference String?
  status           String?               @default("Unpaid")
  remarks          String?
  customId         String?               @unique
  createdAt        DateTime              @default(now())
  payments         ContributionPayment[]

  @@unique([memberId, month, year])
  @@index([month, year])
}

model ContributionPayment {
  id             Int          @id @default(autoincrement())
  contributionId Int
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  memberId       Int?
  member         Member?      @relation(fields: [memberId], references: [id])
  amount         Float
  paymentDate    String
  paymentMethod  String       @default("M-Pesa")
  mpesaRef       String?
  bankRef        String?
  reference      String?
  remarks        String?
  recordedBy     String?
  createdAt      DateTime     @default(now())

  @@index([contributionId])
  @@index([memberId])
}

model Loan {
  id                   String          @id
  memberId             Int
  member               Member          @relation(fields: [memberId], references: [id])
  issueDate            DateTime
  principal            Float
  interest             Float
  totalPayable         Float
  paidAmount           Float           @default(0.0)
  principalPaid        Float           @default(0.0)
  interestPaid         Float           @default(0.0)
  interestRate         Float           @default(10.0)
  interestMethod       String          @default("Simple")
  compoundingFrequency String          @default("Monthly")
  durationMonths       Int             @default(6)
  repaymentTerms       String?         @default("Monthly Anniversary")
  allocationPolicy     String          @default("Interest First")
  purpose              String?         @default("Personal / Business Development")
  approvalRef          String?
  remarks              String?
  status               String          @default("Active")
  clearedDate          DateTime?
  completedPeriods     Int?
  repayments           LoanRepayment[]

  @@index([memberId])
  @@index([status])
}

model LoanRepayment {
  id                 Int      @id @default(autoincrement())
  loanId             String
  loan               Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  memberId           Int?
  member             Member?  @relation(fields: [memberId], references: [id])
  paymentDate        DateTime @default(now())
  paymentDateStr     String
  amount             Float
  interestAllocated  Float    @default(0.0)
  principalAllocated Float    @default(0.0)
  paymentMethod      String   @default("M-Pesa")
  mpesaRef           String?
  bankRef            String?
  reference          String?
  remarks            String?
  recordedBy         String?
  createdAt          DateTime @default(now())

  @@index([loanId])
  @@index([memberId])
}

model Expense {
  id               Int      @id @default(autoincrement())
  expenseDate      DateTime
  description      String
  amount           Float
  expenseType      String
  referenceDetails String?
}

model Penalty {
  id                    Int                  @id @default(autoincrement())
  memberId              Int
  member                Member               @relation(fields: [memberId], references: [id])
  monthYear             String
  dueDate               DateTime             @default(now())
  dateLevied            DateTime             @default(now())
  unsettledContribution Float                @default(0.0)
  penaltyAmount         Float                @default(500.0)
  paidAmount            Float                @default(0.0)
  paidContribution      Float                @default(0.0)
  paidFine              Float                @default(0.0)
  remainingBalance      Float                @default(0.0)
  status                String               @default("UNPAID")
  reason                String               @default("Late Contribution & Unsettled Dues")
  duesType              String               @default("Contribution & Fine")
  contributionId        Int?
  datePaid              String?
  payments              PaymentTransaction[]

  @@unique([memberId, monthYear, duesType])
}

model PaymentTransaction {
  id                    Int      @id @default(autoincrement())
  penaltyId             Int
  penalty               Penalty  @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  amount                Float
  allocatedContribution Float    @default(0.0)
  allocatedFine         Float    @default(0.0)
  paymentDate           DateTime @default(now())
  paymentMethod         String   @default("M-PESA")
  reference             String?
  notes                 String?
  createdByUser         String?
}

model Investment {
  id             String   @id
  asset          String
  type           String
  capital        Float
  status         String   @default("Active")
  expectedReturn String
  createdAt      DateTime @default(now())
}

model Project {
  id        String   @id
  name      String
  budget    Float
  status    String   @default("Active")
  manager   String
  createdAt DateTime @default(now())
}

model Supplier {
  id        String   @id
  name      String
  category  String
  contact   String
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id
  name      String
  category  String
  link      String   @default("#")
  status    String   @default("Available")
  createdAt DateTime @default(now())
}

model Asset {
  id          String   @id
  name        String
  category    String
  valuation   Float    @default(0.0)
  cost        Float?   @default(0.0)
  location    String   @default("Nairobi")
  custodian   String?  @default("Dreamloom Trustees")
  status      String   @default("Active")
  createdAt   DateTime @default(now())
}

model Inventory {
  id           String   @id
  sku          String   @unique
  name         String
  category     String
  location     String   @default("Executive Safe")
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  unitValue    Float    @default(0.0)
  totalValue   Float    @default(0.0)
  status       String   @default("In Stock")
  createdAt    DateTime @default(now())
}


model Deposit {
  id                    Int       @id @default(autoincrement())
  customId              String    @unique
  date                  DateTime  @default(now())
  depositorName         String
  amount                Float
  transactionType       String
  customTransactionType String?
  reason                String
  reference             String?
  paymentMethod         String    @default("M-Pesa")
  receivingAccount      String    @default("Equity Bank - A/C 1760287177880")
  memberId              Int?
  member                Member?   @relation(fields: [memberId], references: [id])
  allocationType        String?   @default("None")
  allocationRef         String?
  contributionId        Int?
  loanId                String?
  projectId             String?
  investmentId          String?
  reconciliationStatus  String    @default("Unreconciled")
  reconciledAt          DateTime?
  reconciledBy          String?
  reconciliationNotes   String?
  attachmentUrl         String?
  attachmentName        String?
  isReversed            Boolean   @default(false)
  reversalReason        String?
  reversedAt            DateTime?
  reversedBy            String?
  createdByUser         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model ThePlanImage {
  id        String   @id
  projectId String
  title     String
  caption   String   @default("")
  tag       String?  @default("")
  src       String
  isCover   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model EmergencyFundSettings {
  id                    Int      @id @default(autoincrement())
  fundName              String   @default("Dreamloom Members' Emergency and Welfare Fund")
  monthlyAllocation     Float    @default(1000.0)
  interestRate          Float    @default(10.0)
  repaymentPeriodMonths Int      @default(1)
  calculationMethod     String   @default("Simple")
  updatedBy             String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model EmergencyFundAllocation {
  id                 Int      @id @default(autoincrement())
  memberId           Int
  member             Member   @relation(fields: [memberId], references: [id])
  month              String
  year               Int
  monthYear          String
  amount             Float    @default(1000.0)
  sourceContribution String   @default("Internal Allocation (from Monthly KSh 6,000 Contribution)")
  status             String   @default("Allocated")
  notes              String?
  recordedBy         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([memberId, month, year])
  @@index([month, year])
  @@index([memberId])
}

model EmergencyLoanApplication {
  id                       String                  @id
  memberId                 Int
  member                   Member                  @relation(fields: [memberId], references: [id])
  applicationDate          DateTime                @default(now())
  amountRequested          Float
  reason                   String
  supportingDocs           String?
  proposedRepaymentDate    DateTime
  status                   String                  @default("Pending")
  currentOutstandingBalance Float                  @default(0.0)
  applicantNotes           String?
  reviewNotes              String?
  reviewedBy               String?
  reviewedAt               DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  loan                     EmergencyLoan?
  approvals                EmergencyLoanApproval[]

  @@index([memberId])
  @@index([status])
}

model EmergencyLoanApproval {
  id                  Int                      @id @default(autoincrement())
  applicationId       String
  application         EmergencyLoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approverMemberId    Int?
  approverName        String
  approverRole        String
  resolutionReference String
  legalDisclosure     String
  decision            String                   @default("Approved")
  decisionDate        DateTime                 @default(now())
  conditions          String?
  signatureRef        String?
  createdAt           DateTime                 @default(now())

  @@index([applicationId])
}

model EmergencyLoan {
  id                 String                   @id
  applicationId      String?                  @unique
  application        EmergencyLoanApplication? @relation(fields: [applicationId], references: [id])
  memberId           Int
  member             Member                   @relation(fields: [memberId], references: [id])
  disbursementDate   DateTime                 @default(now())
  principal          Float
  interestRate       Float                    @default(10.0)
  durationMonths     Int                      @default(1)
  interestAmount     Float
  totalPayable       Float
  principalPaid      Float                    @default(0.0)
  interestPaid       Float                    @default(0.0)
  totalPaid          Float                    @default(0.0)
  principalBalance   Float
  interestBalance    Float
  totalBalance       Float
  dueDate            DateTime
  paymentMethod      String                   @default("M-Pesa")
  paymentReference   String
  approvalReference  String
  status             String                   @default("Active")
  disbursedBy        String
  clearedDate        DateTime?
  remarks            String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  repayments         EmergencyLoanRepayment[]

  @@index([memberId])
  @@index([status])
}

model EmergencyLoanRepayment {
  id            Int           @id @default(autoincrement())
  loanId        String
  loan          EmergencyLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  memberId      Int
  member        Member        @relation(fields: [memberId], references: [id])
  repaymentDate DateTime      @default(now())
  amount        Float
  principalPaid Float         @default(0.0)
  interestPaid  Float         @default(0.0)
  paymentMethod String        @default("M-Pesa")
  reference     String
  remarks       String?
  recordedBy    String
  createdAt     DateTime      @default(now())

  @@index([loanId])
  @@index([memberId])
}

model EmergencyFundTransaction {
  id                    String    @id
  transactionDate       DateTime  @default(now())
  type                  String
  category              String
  amount                Float
  memberId              Int?
  memberName            String?
  referenceId           String?
  paymentMethod         String?
  paymentReference      String?
  description           String
  performedBy           String
  isReversed            Boolean   @default(false)
  reversedAt            DateTime?
  reversalReason        String?
  reversalTransactionId String?
  createdAt             DateTime  @default(now())

  @@index([type])
  @@index([memberId])
  @@index([transactionDate])
}

