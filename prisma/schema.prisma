datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  passwordHash   String
  fullName       String
  role           String     @default("Member")
  isActive       Boolean    @default(true)
  mustChangePass Boolean    @default(true)
  loginLogs      LoginLog[]
  editLogs       EditLog[]
  member         Member?
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  email     String?
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())
}

model EditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  model     String   // e.g., "Contribution"
  action    String   // "create", "update", "delete"
  recordId  Int?
  changes   String?
  createdAt DateTime @default(now())
}

model Member {
  id                   Int                   @id @default(autoincrement())
  fullName             String
  nationalId           String                @unique
  phone                String
  email                String                @unique
  role                 String                @default("Member")
  contributions        Contribution[]
  contributionPayments ContributionPayment[]
  loans                Loan[]
  loanRepayments       LoanRepayment[]
  penalties            Penalty[]
  deposits             Deposit[]
  userId               Int?                  @unique
  user                 User?                 @relation(fields: [userId], references: [id])
}

model Contribution {
  id               Int                   @id @default(autoincrement())
  memberId         Int?
  member           Member?               @relation(fields: [memberId], references: [id])
  monthYear        String
  month            String?
  year             Int?
  expectedAmount   Float                 @default(6000.0)
  amount           Float                 @default(0.0)
  unsettled        Float                 @default(0.0)
  creditBalance    Float                 @default(0.0)
  payout           Float                 @default(0.0)
  paymentDate      String?
  paymentMethod    String?               @default("M-Pesa")
  mpesaRef         String?
  bankRef          String?
  paymentReference String?
  status           String?               @default("Unpaid")
  remarks          String?
  customId         String?               @unique
  createdAt        DateTime              @default(now())
  payments         ContributionPayment[]
}

model ContributionPayment {
  id             Int          @id @default(autoincrement())
  contributionId Int
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  memberId       Int?
  member         Member?      @relation(fields: [memberId], references: [id])
  amount         Float
  paymentDate    String
  paymentMethod  String       @default("M-Pesa")
  mpesaRef       String?
  bankRef        String?
  reference      String?
  remarks        String?
  recordedBy     String?
  createdAt      DateTime     @default(now())
}

model Loan {
  id                   String          @id
  memberId             Int
  member               Member          @relation(fields: [memberId], references: [id])
  issueDate            DateTime
  principal            Float
  interest             Float
  totalPayable         Float
  paidAmount           Float           @default(0.0)
  principalPaid        Float           @default(0.0)
  interestPaid         Float           @default(0.0)
  interestRate         Float           @default(10.0)
  interestMethod       String          @default("Simple")
  compoundingFrequency String          @default("Monthly")
  durationMonths       Int             @default(6)
  repaymentTerms       String?         @default("Monthly Anniversary")
  allocationPolicy     String          @default("Interest First")
  purpose              String?         @default("Personal / Business Development")
  approvalRef          String?
  remarks              String?
  status               String          @default("Active")
  clearedDate          DateTime?
  repayments           LoanRepayment[]
}

model LoanRepayment {
  id                 Int      @id @default(autoincrement())
  loanId             String
  loan               Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  memberId           Int?
  member             Member?  @relation(fields: [memberId], references: [id])
  paymentDate        DateTime @default(now())
  paymentDateStr     String
  amount             Float
  interestAllocated  Float    @default(0.0)
  principalAllocated Float    @default(0.0)
  paymentMethod      String   @default("M-Pesa")
  mpesaRef           String?
  bankRef            String?
  reference          String?
  remarks            String?
  recordedBy         String?
  createdAt          DateTime @default(now())
}

model Expense {
  id               Int      @id @default(autoincrement())
  expenseDate      DateTime
  description      String
  amount           Float
  expenseType      String
  referenceDetails String?
}

model Penalty {
  id                    Int                  @id @default(autoincrement())
  memberId              Int
  member                Member               @relation(fields: [memberId], references: [id])
  monthYear             String
  dueDate               DateTime             @default(now())
  dateLevied            DateTime             @default(now())
  unsettledContribution Float                @default(0.0)
  penaltyAmount         Float                @default(500.0)
  paidAmount            Float                @default(0.0)
  paidContribution      Float                @default(0.0)
  paidFine              Float                @default(0.0)
  remainingBalance      Float                @default(0.0)
  status                String               @default("UNPAID")
  reason                String               @default("Late Contribution & Unsettled Dues")
  duesType              String               @default("Contribution & Fine")
  contributionId        Int?
  datePaid              String?
  payments              PaymentTransaction[]

  @@unique([memberId, monthYear, duesType])
}

model PaymentTransaction {
  id                    Int      @id @default(autoincrement())
  penaltyId             Int
  penalty               Penalty  @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  amount                Float
  allocatedContribution Float    @default(0.0)
  allocatedFine         Float    @default(0.0)
  paymentDate           DateTime @default(now())
  paymentMethod         String   @default("M-PESA")
  reference             String?
  notes                 String?
  createdByUser         String?
}

model Investment {
  id             String   @id
  asset          String
  type           String
  capital        Float
  status         String   @default("Active")
  expectedReturn String
  createdAt      DateTime @default(now())
}

model Project {
  id        String   @id
  name      String
  budget    Float
  status    String   @default("Active")
  manager   String
  createdAt DateTime @default(now())
}

model Supplier {
  id        String   @id
  name      String
  category  String
  contact   String
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id
  name      String
  category  String
  link      String   @default("#")
  status    String   @default("Available")
  createdAt DateTime @default(now())
}

model Asset {
  id        String   @id
  name      String
  category  String
  valuation Float
  location  String
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model Deposit {
  id                    Int       @id @default(autoincrement())
  customId              String    @unique
  date                  DateTime  @default(now())
  depositorName         String
  amount                Float
  transactionType       String
  customTransactionType String?
  reason                String
  reference             String?
  paymentMethod         String    @default("M-Pesa")
  receivingAccount      String    @default("Equity Bank - A/C 1760287177880")
  memberId              Int?
  member                Member?   @relation(fields: [memberId], references: [id])
  allocationType        String?   @default("None")
  allocationRef         String?
  contributionId        Int?
  loanId                String?
  projectId             String?
  investmentId          String?
  reconciliationStatus  String    @default("Unreconciled")
  reconciledAt          DateTime?
  reconciledBy          String?
  reconciliationNotes   String?
  attachmentUrl         String?
  attachmentName        String?
  isReversed            Boolean   @default(false)
  reversalReason        String?
  reversedAt            DateTime?
  reversedBy            String?
  createdByUser         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
